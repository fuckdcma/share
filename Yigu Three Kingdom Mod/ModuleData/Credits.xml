<!--
	Category 主要类别，橙色文字
	Section 次要类别，亮色文字
	Entry 制作人员，暗淡文字
	EmptyLine 空行
	LoadFromFile 额外嵌入XML内容, 可以插入在 Credits 或者 Category 内部。
		- Name XML 文件名
		- PlatformSpecific 区分平台（会在文件名后面追加 PC 或者 Console）
	<LoadFromFile Name="CreditsExternalPartners" ConsoleSpecific="true" />

	使用例子
	(1): 
	<Category Text="{=!}主要部门">
		<Entry Text="张三" />
		<Entry Text="李四" />
	</Category>

	(2):
	<Category Text="{=!}程序部门">
		<Section Text="{=!}引擎开发">
			<Entry Text="张三" />
			<Entry Text="李四" />
		</Section>
		<EmptyLine />
		<Section Text="{=!}游戏开发">
			<Entry Text="王五" />
		</Section>
	</Category>

	英文翻译在 ModuleData/Languages/EN/CreditEN.xml
-->

