    <Brush Name="Card.Button.Base">
    <Layers>
      <BrushLayer Name="Default" Sprite="" IsHidden="true" />
      <BrushLayer Name="Hovered" Sprite="" IsHidden="true" />
    </Layers>
    <Styles>
      <Style Name="Default">
        <BrushLayer Name="Default" ColorFactor="1.1" IsHidden="false" HorizontalFlip="true" />
      </Style>
      <Style Name="Hovered">
        <BrushLayer Name="Hovered" ColorFactor="1.1" IsHidden="false" HorizontalFlip="true" />
      </Style>
      <Style Name="Pressed">
        <BrushLayer Name="Hovered" ColorFactor="0.8" IsHidden="false" HorizontalFlip="true" />
      </Style>
      <Style Name="Selected">
        <BrushLayer Name="Default" ColorFactor="1.2" IsHidden="false" HorizontalFlip="true" />
      </Style>
      <Style Name="Disabled">
        <BrushLayer Name="Default" ColorFactor="0.5" IsHidden="false" HorizontalFlip="true" />
      </Style>
    </Styles>
  </Brush>
  
  <Brush Name="Card.Board" BaseBrush="Card.Button.Base">
    <Layers>
      <BrushLayer Name="Default" Sprite="CardSelected_02\CardSelected02_00001" IsHidden="true" />
      <BrushLayer Name="Hovered" Sprite="CardSelected_02\CardSelected02_00002" IsHidden="true" />
    </Layers>
    <SoundProperties>
      <EventSounds>
        <EventSound EventName="Click" Audio="panels/next" />
      </EventSounds>
    </SoundProperties>
  </Brush>
  
    <Brush Name="Card.Click" BaseBrush="Card.Button.Base">
    <Layers>
      <BrushLayer Name="Default" Sprite="" IsHidden="true" />
      <BrushLayer Name="Hovered" Sprite="" IsHidden="true" />
    </Layers>
    <SoundProperties>
      <EventSounds>
        <EventSound EventName="Click" Audio="panels/next" />
      </EventSounds>
    </SoundProperties>
  </Brush>
