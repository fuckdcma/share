					<Children>	
						<ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Right" VerticalAlignment="Center" PositionXOffset="20">
							<Children>				
								<TextWidget Text="@BandageInfoText" WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Center" VerticalAlignment="Center" Brush="Bandage.Info.Text" Brush.FontColor="@Color"/>			
							</Children>	
						</ListPanel>
					</Children>	
				</Widget>
			
			
