				<Widget Id="BandageCureHint"  WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="100" SuggestedHeight="60" HorizontalAlignment="Right"  VerticalAlignment="Bottom" MarginRight="320" 	MarginBottom="100"   >
					<Children>	
						<Widget DataSource="{BuffDamageList}" DoNotAcceptEvents="true" DoNotPassEventsToChildren="true" WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"  >
							<ItemTemplate>				
								<BuffHintWidget Text="@CureValue" WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Center" VerticalAlignment="Center" Brush="Bandage.Info.Text" Brush.FontColor="@CureColor" Brush.FontSize="@CureSize" DurationTime="@DurationTime" DefaultSize="@DefaultSize" YOffectSpeed="@YOffectSpeed" AlphaFeadSpeed="0.8"  IsVisible="@CureIsEnabled"/>			
