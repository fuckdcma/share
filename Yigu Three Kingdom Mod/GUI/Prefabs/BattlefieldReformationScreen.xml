				 <SkillIconWidget Sprite="Skill_Scatter"  StateControl="@SkillState" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="85" SuggestedHeight="85" HorizontalAlignment="Center"  VerticalAlignment="Bottom" IsVisible="@SalvoIsEnabled">
					<Children>	
						<TextWidget Text="@SalvoCount" WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Right" VerticalAlignment="Bottom" Brush="Bandage.Info.Text"  Brush.FontSize="30"  />	
					</Children>	
				</SkillIconWidget>
				
				<SpriteAnimationWidget  WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SpriteName="killingEffect" 
				SuggestedWidth="280" SuggestedHeight="240" 
				HorizontalAlignment="Left"  VerticalAlignment="Bottom"
				MarginLeft="180"  MarginBottom="280" AnimationSpeed="2"
				 IsPlaying="@IsPlaying"  />
				
				<!--  治疗 -->
				<BuffIconWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="60" SuggestedHeight="60" Sprite="Curebuff"  StateControl="@CureBuffState"  HorizontalAlignment="Right"  VerticalAlignment="Bottom" MarginRight="310" 	MarginBottom="120" ScaleSpeed="0.3" />
				<!--  流血 -->
				<BuffIconWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="60" SuggestedHeight="60" Sprite="Bleedbuff"  StateControl="@BleedBuffState"  HorizontalAlignment="Right"  VerticalAlignment="Bottom" MarginRight="310" 	MarginBottom="170" ScaleSpeed="0.3" />
				<!--  中毒 -->
				<BuffIconWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="60" SuggestedHeight="60" Sprite="Poisonbuff"  StateControl="@PoisonBuffState"  HorizontalAlignment="Right"  VerticalAlignment="Bottom" MarginRight="320" 	MarginBottom="70" ScaleSpeed="0.3" />			
				<!--  战马加速 -->
				<BuffIconWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="60" SuggestedHeight="60" Sprite="HorseAccelerate"  StateControl="@HorseAccelerateBuffState"  HorizontalAlignment="Right"  VerticalAlignment="Bottom" MarginRight="300" 	MarginBottom="20" ScaleSpeed="0.25" />
			
