<Prefab>
  <Constants>

  </Constants>
  <Window>
    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent">
      <Children>
        <MultiplayerDeathCardWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="346" SuggestedHeight="150" MarginLeft="22" MarginTop="176" FadeInModifier="5" FadeOutModifier="10" IsActive="@IsActive" IsSelfInflicted="@IsSelfInflicted" KillCountsEnabled="@KillCountsEnabled" KillCountContainer="LayoutParent\KillCountContainer" KillerNameTextWidget="LayoutParent\LayoutWidget\TroopIconKilledTextsContainer\KilledTextsContainer\KillerNameTextWidget" TitleTextWidget="LayoutParent\LayoutWidget\TroopIconKilledTextsContainer\KilledTextsContainer\TitleTextWidget" WeaponTextWidget="LayoutParent\LayoutWidget\WeaponTextWidget" SelfInflictedTitleBrush="MPHUD.DeathCard.SelfKilled.Text" NormalBrushTitleBrush="MPHUD.DeathCard.Small.Text">
          <Children>

            <ListPanel Id="LayoutParent" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent">
              <Children>

                <ListPanel Id="LayoutWidget" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" StackLayout.LayoutMethod="VerticalTopToBottom" Sprite="BlankWhiteSquare_9" Color="#000000AA">
                  <Children>

                    <!--Troop Icon - and Killed texts-->
                    <ListPanel Id="TroopIconKilledTextsContainer" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginLeft="31" MarginTop="17" MarginBottom="14" >
                      <Children>
                        
                        <Widget DataSource="{PlayerProperties}" WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren">
                          <Children>
                            <!--Troop Icon-->
                            <Widget DataSource="{CompassElement}" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="40" SuggestedHeight="40" VerticalAlignment="Center">
                              <Children>
                                <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="36" SuggestedHeight="36" HorizontalAlignment="Right" VerticalAlignment="Center">
                                  <Children>
                                    <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="41" SuggestedHeight="41" HorizontalAlignment="Center" VerticalAlignment="Center" Sprite="MPHud\banner_outline" Color="@Color2" AlphaFactor="0.8"/>
                                    <ImageIdentifierWidget DataSource="{Banner}" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="36" SuggestedHeight="36" HorizontalAlignment="Center" VerticalAlignment="Center" ImageId="@Id" AdditionalArgs="@AdditionalArgs" TextureProviderName="@TextureProviderName" CircularClipEnabled="true" CircularClipRadius="18"/>
                                  </Children>
                                </Widget>
                                <MultiplayerTroopTypeIconWidget Id="IconContainer" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="25" SuggestedHeight="40" HorizontalAlignment="Right" VerticalAlignment="Center" MarginRight="20" ForegroundWidget="IconForeground" ScaleFactor="1.35" IconSpriteType="@IconSpriteType" Color="@Color">
                                  <Children>
                                    <Widget Id="IconForeground" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Color="@Color2"/>
                                  </Children>
                                </MultiplayerTroopTypeIconWidget>
                              </Children>
                            </Widget>
                          </Children>
                        </Widget>

                        <!--Killed Texts-->
                        <ListPanel Id="KilledTextsContainer" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" StackLayout.LayoutMethod="VerticalTopToBottom" MarginLeft="10" VerticalAlignment="Center">
                          <Children>
                            <TextWidget Id="TitleTextWidget" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginTop="5" MarginBottom="5" Brush="MPHUD.DeathCard.Small.Text" Text="@TitleText" />
                            <ScrollingRichTextWidget Id="KillerNameTextWidget" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginTop="0" MarginRight="10" Brush="MPHUD.DeathCard.Text" Text="@KillerName" />
                          </Children>
                        </ListPanel>

                      </Children>
                    </ListPanel>
                    
                    <TextWidget Id="WeaponTextWidget" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" Brush="MPHUD.DeathCard.Small.Text" Brush.TextHorizontalAlignment="Left" MarginLeft="82" MarginBottom="22" Text="@UsedWeaponName" />
                  </Children>
                </ListPanel>

                <Widget Id="KillCountContainer" WidthSizePolicy="Fixed" HeightSizePolicy="CoverChildren" SuggestedWidth="65" MarginLeft="5" Sprite="BlankWhiteSquare_9" Color="#000000AA">
                  <Children>
                    <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" StackLayout.LayoutMethod="VerticalTopToBottom">
                      <Children>
                        <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Center" MarginTop="9" Brush="MPHUD.DeathCard.Small.Text"  Text="@YouText"/>
                        <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Center" MarginTop="5" Brush="MPHUD.DeathCard.Medium.Text" IntText="@NumOfTimesPlayerKilled"/>
                        <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="17" SuggestedHeight="1" HorizontalAlignment="Center" MarginTop="5" Sprite="BlankWhiteSquare_9"/>
                        <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Center" MarginTop="10" Brush="MPHUD.DeathCard.Medium.Text" Brush.FontColor="#BD1D1DFF" IntText="@NumOfTimesPlayerGotKilled"/>
                        <ScrollingRichTextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" HorizontalAlignment="Center" MarginTop="5" MarginBottom="9" MarginLeft="2" MarginRight="2" Brush="MPHUD.DeathCard.Small.Text" Brush.FontColor="#BD1D1DFF" Text="@KillerText" DefaultTextHorizontalAlignment="Center" />
                      </Children>
                    </ListPanel>
                  </Children>
                </Widget>

              </Children>
            </ListPanel>
          </Children>
        </MultiplayerDeathCardWidget>
      </Children>
    </Widget>
  </Window>
</Prefab>