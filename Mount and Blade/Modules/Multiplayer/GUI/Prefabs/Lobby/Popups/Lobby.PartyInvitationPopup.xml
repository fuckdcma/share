<Prefab>
  <Constants>
    <Constant Name="DoneButton.Width" BrushLayer="Default" BrushName="MPLobby.Popup.DoneButton" BrushValueType="Width" />
    <Constant Name="DoneButton.Height" BrushLayer="Default" BrushName="MPLobby.Popup.DoneButton" BrushValueType="Height" />

    <Constant Name="CloseButton.Width" BrushLayer="Default" BrushName="MPLobby.Popup.CloseButton" BrushValueType="Width" />
    <Constant Name="CloseButton.Height" BrushLayer="Default" BrushName="MPLobby.Popup.CloseButton" BrushValueType="Height" />
  </Constants>
  <Window>
    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="BlankWhiteSquare_9" Color="#000000FF" AlphaFactor="0.8">
      <Children>
        <ListPanel StackLayout.LayoutMethod="VerticalTopToBottom" WidthSizePolicy="Fixed" HeightSizePolicy="CoverChildren" SuggestedWidth="800" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Children>
            <TextWidget Text="@Title" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginBottom="20" Brush="MPLobby.Popup.HeaderText" />
            <TextWidget Text="@Message" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" Brush="MPLobby.Popup.MessageText" />

            <ListPanel DataSource="{InvitingPlayer}" WidthSizePolicy="CoverChildren" HeightSizePolicy="Fixed" SuggestedHeight="53" HorizontalAlignment="Center" VerticalAlignment="Bottom" MarginTop="30">
              <Children>
                <ImageIdentifierWidget DataSource="{Avatar}" ImageId="@Id" AdditionalArgs="@AdditionalArgs" IsVisible="@IsValid" TextureProviderName="@TextureProviderName" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="53" SuggestedHeight="53" VerticalAlignment="Center" />
                <TextWidget Text="@Name" WidthSizePolicy="CoverChildren" HeightSizePolicy="StretchToParent" MarginLeft="10" Brush="MPLobby.PartyInvitationPopup.PlayerName" />
              </Children>
            </ListPanel>

			<FillBarWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="300" SuggestedHeight="10" HorizontalAlignment="Center" MarginTop="30" FillWidget="FillWidget" Sprite="BlankWhiteSquare_9" Color="#555555FF" MaxAmountAsFloat="@MaxAnswerDuration" InitialAmountAsFloat="@RemainingAnswerDuration">
			  <Children>
				<Widget Id="FillWidget" WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" Sprite="BlankWhiteSquare_9" Color="#F2AF48FF"/>
			  </Children>
			</FillBarWidget>

            <ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Center" VerticalAlignment="Bottom" MarginTop="15">
              <Children>
                <ButtonWidget Command.Click="ExecuteAccept" DoNotPassEventsToChildren="true" UpdateChildrenStates="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="!DoneButton.Width" SuggestedHeight="!DoneButton.Height" MarginRight="20" Brush="MPLobby.Popup.DoneButton"/>
                <ButtonWidget Command.Click="ExecuteDecline" DoNotPassEventsToChildren="true" UpdateChildrenStates="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="!CloseButton.Width" SuggestedHeight="!CloseButton.Height" MarginLeft="20" Brush="MPLobby.Popup.CloseButton"/>
              </Children>
            </ListPanel>
          </Children>
        </ListPanel>
      </Children>
    </Widget>
  </Window>
</Prefab>