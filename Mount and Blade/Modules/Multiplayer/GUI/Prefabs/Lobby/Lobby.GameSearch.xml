<Prefab>
  <Constants>
    <Constant Name="Background.Width" BrushName="MPLobby.GameSearch.Background" BrushLayer="Default" BrushValueType="Width"/>
    <Constant Name="Background.Height" BrushName="MPLobby.GameSearch.Background" BrushLayer="Default" BrushValueType="Height"/>
  </Constants>
  <Window>
    <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="!Background.Width" SuggestedHeight="!Background.Height" HorizontalAlignment="Center" VerticalAlignment="Bottom" MarginBottom="15" Sprite="MPLobby\Home\looking_for_game_popup" >
      <Children>
        <TextWidget Text="@TitleText" WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="40" MarginTop="35" Brush="MPLobby.GameSearch.TitleText" />

        <TextWidget Text="@GameTypesText" WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="25" MarginTop="75" Brush="MPLobby.GameSearch.GameTypeText" />

        <ButtonWidget IsEnabled="@CanEnterPracticeBattle" Command.Click="ExecutePractice" DoNotPassEventsToChildren="true" UpdateChildrenStates="true" WidthSizePolicy="CoverChildren" HeightSizePolicy="Fixed" SuggestedHeight="20" HorizontalAlignment="Center" MarginTop="100" IsVisible="false">
          <Children>
            <TextWidget Text="@PracticeText" WidthSizePolicy="CoverChildren" HeightSizePolicy="StretchToParent" MarginLeft="5" MarginRight="5" Brush="MPLobby.GameSearch.PracticeText" />
          </Children>
        </ButtonWidget>

        <ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Center" MarginTop="102" StackLayout.LayoutMethod="VerticalTopToBottom" IsVisible="@ShowStats">
          <Children>

            <ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Center" MarginTop="3">
              <Children>
                <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" Brush="MPLobby.GameSearch.WaitingPlayers.Value" Text="@CurrentWaitingTime" />
                <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" Brush="MPLobby.GameSearch.WaitingPlayers.Description" Text="@CurrentWaitingTimeDescription" />
              </Children>
            </ListPanel>

            <ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Center">
              <Children>
                <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" Brush="MPLobby.GameSearch.WaitingPlayers.Value" Text="@AverageWaitingTime" />
                <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" Brush="MPLobby.GameSearch.WaitingPlayers.Description" Text="@AverageWaitingTimeDescription" />
              </Children>
            </ListPanel>

          </Children>
        </ListPanel>
        <ButtonWidget IsEnabled="@CanCancelSearch" Command.Click="ExecuteCancel" DoNotPassEventsToChildren="true" UpdateChildrenStates="true" WidthSizePolicy="CoverChildren" HeightSizePolicy="Fixed" SuggestedHeight="40" HorizontalAlignment="Center" MarginTop="150">
          <Children>
            <TextWidget Text="@CancelText" WidthSizePolicy="CoverChildren" HeightSizePolicy="StretchToParent" MarginLeft="5" MarginRight="5" Brush="MPLobby.GameSearch.ButtonText" />
          </Children>
        </ButtonWidget>
      </Children>
    </Widget>
  </Window>
</Prefab>