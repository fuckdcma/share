<Prefab>
  <Constants>
    <Constant Name="TopHeader.Width" BrushName="MPLobby.TopHeader.Background" BrushLayer="Default" BrushValueType="Width"/>
    <Constant Name="TopHeader.Height" BrushName="MPLobby.TopHeader.Background" BrushLayer="Default" BrushValueType="Height"/>

    <Constant Name="TopHeader.SettingsButton.Width" BrushName="MPLobby.TopHeader.SettingsButton" BrushLayer="Default" BrushValueType="Width"/>
    <Constant Name="TopHeader.SettingsButton.Height" BrushName="MPLobby.TopHeader.SettingsButton" BrushLayer="Default" BrushValueType="Height"/>

    <Constant Name="TopHeader.LeaveButton.Width" BrushName="MPLobby.TopHeader.LeaveButton" BrushLayer="Default" BrushValueType="Width"/>
    <Constant Name="TopHeader.LeaveButton.Height" BrushName="MPLobby.TopHeader.LeaveButton" BrushLayer="Default" BrushValueType="Height"/>
  </Constants>
  <Window>
    <MultiplayerLobbyMenuWidget SelectedItemIndex="@PageIndex" MenuItemListPanel="Panel\ButtonContainer" WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="!TopHeader.Height" HorizontalAlignment="Center" Sprite="MPLobby\Generic\top_header" ExtendBottom="32" MatchmakingButtonWidget="Panel\ButtonContainer\MatchmakingButton" >
      <Children>
        <Widget Id="Panel" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginLeft="10" MarginRight="10" PositionYOffset="-5">
          <Children>
            
            <InputKeyVisualWidget DataSource="{PreviousPageInputKey}" DoNotAcceptEvents="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="60" SuggestedHeight="60" HorizontalAlignment="Left" VerticalAlignment="Center" PositionXOffset="70" KeyID="@KeyID" IsVisible="@IsVisible"/>

            <ListPanel Id="ButtonContainer" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginRight="!TopHeader.LeaveButton.Width" DoNotAcceptEvents="true">
              <Children>
                <ToggleStateButtonWidget AllowSwitchOff="false" Command.Click="ExecuteOptions" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="!TopHeader.SettingsButton.Width" SuggestedHeight="!TopHeader.SettingsButton.Height" VerticalAlignment="Center" Brush="MPLobby.TopHeader.SettingsButton" />

                <ToggleStateButtonWidget Id="HomeButton" AllowSwitchOff="false" Command.Click="ExecuteHome" UpdateChildrenStates="true" HorizontalAlignment="Center" WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="70" DoNotPassEventsToChildren="true" VerticalAlignment="Center" Brush="MPLobby.MenuItem.Sound.Brush">
                  <Children>
                    <TextWidget Text="@HomeText" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="MPLobby.TopHeader.MiddleButtonText" />
                    <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="27" SuggestedHeight="12" HorizontalAlignment="Center" VerticalAlignment="Bottom" PositionYOffset="5" Sprite="MPLobby\Generic\top_header_notch" AlphaFactor="0.6" />
                    <BrushWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="447" SuggestedHeight="89" HorizontalAlignment="Center" PositionYOffset="-2" Brush="MPLobby.TopHeader.HoverGlow.Centered" />
                  </Children>
                </ToggleStateButtonWidget>

                <ToggleStateButtonWidget Id="ArmoryButton" UpdateChildrenStates="true" AllowSwitchOff="false" Command.Click="ExecuteArmory" WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="70" DoNotPassEventsToChildren="true" VerticalAlignment="Center" Brush="MPLobby.MenuItem.Sound.Brush">
                  <Children>
                    <TextWidget Text="@ArmoryText" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="MPLobby.TopHeader.MiddleButtonText" />
                    <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="27" SuggestedHeight="12" HorizontalAlignment="Center" VerticalAlignment="Bottom" PositionYOffset="5" Sprite="MPLobby\Generic\top_header_notch" AlphaFactor="0.6" />
                    <BrushWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="447" SuggestedHeight="89" HorizontalAlignment="Center" PositionXOffset="15" PositionYOffset="-2" Brush="MPLobby.TopHeader.HoverGlow.Middle" />
                  </Children>
                </ToggleStateButtonWidget>

                <ToggleStateButtonWidget Id="MatchmakingButton" AllowSwitchOff="false" Command.Click="ExecuteMatchmaking" WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="70" DoNotPassEventsToChildren="true" UpdateChildrenStates="true" VerticalAlignment="Center" Brush="MPLobby.MenuItem.Sound.Brush" IsVisible="@IsMatchmakingSupported">
                  <Children>
                    <TextWidget Text="@MatchmakingText" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="MPLobby.TopHeader.MiddleButtonText" />
                    <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="27" SuggestedHeight="12" HorizontalAlignment="Center" VerticalAlignment="Bottom" PositionYOffset="5" Sprite="MPLobby\Generic\top_header_notch" AlphaFactor="0.6" />
                    <BrushWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="447" SuggestedHeight="89" HorizontalAlignment="Center" PositionXOffset="15" PositionYOffset="-2" Brush="MPLobby.TopHeader.HoverGlow.Middle" />
                  </Children>
                </ToggleStateButtonWidget>

                <ToggleStateButtonWidget Id="ProfileButton" AllowSwitchOff="false" Command.Click="ExecuteProfile" WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="70" DoNotPassEventsToChildren="true" UpdateChildrenStates="true" VerticalAlignment="Center" Brush="MPLobby.MenuItem.Sound.Brush" >
                  <Children>
                    <TextWidget Text="@ProfileText" WidthSizePolicy="CoverChildren" HeightSizePolicy="StretchToParent" HorizontalAlignment="Center" Brush="MPLobby.TopHeader.MiddleButtonText" >
                      <Children>
                        <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="23" SuggestedHeight="23" Sprite="MPLobby\Generic\notification_icon" HorizontalAlignment="Right" PositionXOffset="32" PositionYOffset="-3"  VerticalAlignment="Center" Color="#FEC157FF" IsVisible="@HasProfileNotification" />
                      </Children>
                    </TextWidget>
                    <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="27" SuggestedHeight="12" HorizontalAlignment="Center" VerticalAlignment="Bottom" PositionYOffset="5" Sprite="MPLobby\Generic\top_header_notch" AlphaFactor="0.6" />
                    <BrushWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="447" SuggestedHeight="89" HorizontalAlignment="Center" PositionXOffset="15" Brush="MPLobby.TopHeader.HoverGlow.Middle" />
                  </Children>
                </ToggleStateButtonWidget>

              </Children>
            </ListPanel>
            <InputKeyVisualWidget DataSource="{NextPageInputKey}" DoNotAcceptEvents="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="60" SuggestedHeight="60" HorizontalAlignment="Right" VerticalAlignment="Center" PositionXOffset="-90" KeyID="@KeyID" IsVisible="@IsVisible"/>

            <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="!TopHeader.LeaveButton.Width" SuggestedHeight="!TopHeader.LeaveButton.Height" HorizontalAlignment="Right" VerticalAlignment="Center" MarginRight="10" Brush="MPLobby.TopHeader.LeaveButton" Command.Click="ExecuteExit" IsDisabled="@IsDisconnecting"/>
          </Children>
        </Widget>
      </Children>
    </MultiplayerLobbyMenuWidget>
  </Window>
</Prefab>