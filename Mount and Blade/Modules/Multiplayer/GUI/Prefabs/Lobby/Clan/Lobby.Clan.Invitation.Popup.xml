<Prefab>
  <Constants>
    <Constant Name="Divider.Width" BrushName="MPEscapeMenu.Divider" BrushLayer="Default" BrushValueType="Width"/>
    <Constant Name="Divider.Height" BrushName="MPEscapeMenu.Divider" BrushLayer="Default" BrushValueType="Height"/>
  </Constants>
	<Window>
		<Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="BlankWhiteSquare_9" Color="#000000FF" AlphaFactor="0.7" >
      <Children>

        <Widget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="382" Sprite="escape_menu_gradient_9" />
        <Widget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="382" HorizontalAlignment="Right" Sprite="escape_menu_gradient_9" HorizontalFlip="true" />
        
        <Widget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="750" HorizontalAlignment="Center" VerticalAlignment="Center" Sprite="flat_panel_9" >
          <Children>

            <Widget ClipContents="true" WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="533" MarginLeft="60" MarginRight="60" VerticalAlignment="Bottom">
              <Children>
                <Widget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="1377" Sprite="StdAssets\flat_panel_texture" />
              </Children>
            </Widget>

            <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginTop="30" VerticalAlignment="Top" StackLayout.LayoutMethod="VerticalTopToBottom">
              <Children>
                <!--Title-->
                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginBottom="15" Brush="MPLobby.Clan.Popup.Title" Text="@TitleText"/>

                <!--Separator-->
                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="20" Sprite="MPLobby\Matchmaking\information_panel_header" MarginLeft="60" MarginRight="60" MarginBottom="20"/>
                
                <!--You Received An Invite From-->
                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="50" MarginBottom="10" Brush="MPLobby.Clan.Popup.SubTitle.Text" Text="@InviteReceivedText"/>

                <!--Name and Tag-->
                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginBottom="10" Brush="MPLobby.Clan.Popup.ClanName.Text" Text="@ClanNameAndTag"/>

                <!--Along With These Players-->
                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginBottom="40" Brush="MPLobby.Clan.Popup.SubTitle.Text" Text="@WithPlayersText" IsVisible="@IsCreation"/>

                <!--Party Members -->
				  <GridWidget DataSource="{PartyMembersList}" WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Center" MarginBottom="75" DefaultCellWidth="160" DefaultCellHeight="120" ColumnCount="3" LayoutImp="GridLayout" ClipContents="true" >
					  <ItemTemplate>
                    <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="150" SuggestedHeight="100">
                      <Children>
						  <ButtonWidget DoNotPassEventsToChildren="true" UpdateChildrenStates="true" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" HorizontalAlignment="Center" VerticalAlignment="Center" >
							  <Children>
								  <ImageIdentifierWidget DataSource="{Avatar}" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="65" SuggestedHeight="65" HorizontalAlignment="Center" VerticalAlignment="Top" ImageId="@Id" AdditionalArgs="@AdditionalArgs" IsVisible="@IsValid" TextureProviderName="@TextureProviderName" />
								  <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" VerticalAlignment="Bottom" Brush="MPLobby.Clan.Name.Text" Brush.FontSize="20" Text="@InviteAcceptInfo" />
							  </Children>
						  </ButtonWidget>
                      </Children>
                    </Widget>
                  </ItemTemplate>
                </GridWidget>

                <!--Do You Want To Join This Clan-->
                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginBottom="30" Brush="MPLobby.Clan.Popup.SubTitle.Text" Text="@WantToJoinText"/>

                <!--Action Buttons-->
                <ListPanel WidthSizePolicy="Fixed" HeightSizePolicy="CoverChildren" SuggestedWidth="250" HorizontalAlignment="Center" StackLayout.LayoutMethod="HorizontalSpaced">
                  <Children>

                    <ButtonWidget DoNotPassEventsToChildren="true" UpdateChildrenStates="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="99" SuggestedHeight="99" Brush="MPLobby.Popup.DoneButton" IsEnabled="true" Command.Click="ExecuteAcceptInvitation" />
                    <ButtonWidget DoNotPassEventsToChildren="true" UpdateChildrenStates="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="99" SuggestedHeight="99" Brush="MPLobby.Popup.CloseButton" IsEnabled="true" Command.Click="ExecuteDeclineInvitation" />

                  </Children>
                </ListPanel>
                
              </Children>
            </ListPanel>

            <Widget ClipContents="true" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginTop="120" MarginLeft="60" MarginRight="60" VerticalAlignment="Top">
              <Children>
                <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="!Divider.Width" SuggestedHeight="!Divider.Height" HorizontalAlignment="Center" Sprite="MPTeamSelection\divider_notched" />
              </Children>
            </Widget>

          </Children>
        </Widget>

      </Children>
    </Widget>
	</Window>
</Prefab>