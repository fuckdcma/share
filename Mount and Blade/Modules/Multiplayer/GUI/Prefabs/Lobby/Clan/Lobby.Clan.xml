<Prefab>
  <Constants>
    <Constant Name="Divider.Width" BrushName="MPEscapeMenu.Divider" BrushLayer="Default" BrushValueType="Width"/>
    <Constant Name="Divider.Height" BrushName="MPEscapeMenu.Divider" BrushLayer="Default" BrushValueType="Height"/>

    <Constant Name="Banner.Width" BrushLayer="Default" BrushName="MPLobby.Clan.Banner" BrushValueType="Width" />
    <Constant Name="Banner.Height" BrushLayer="Default" BrushName="MPLobby.Clan.Banner" BrushValueType="Height" />

    <Constant Name="Banner.Width.Scaled" MultiplyResult="0.60" Value="!Banner.Width" />
    <Constant Name="Banner.Height.Scaled" MultiplyResult="0.84" Value="!Banner.Height" />
  </Constants>
  <Window>
    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="BlankWhiteSquare_9" Color="#000000FF" AlphaFactor="0.7" >
      <Children>

        <NavigationForcedScopeCollectionTargeter CollectionID="LobbyClanCollection" CollectionParent="..\." />
        <Widget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="932" HorizontalAlignment="Center" VerticalAlignment="Center" Sprite="flat_panel_9" >
          <Children>

            <ListPanel  WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" StackLayout.LayoutMethod="VerticalTopToBottom">
              <Children>

                <Widget  WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" StackLayout.LayoutMethod="VerticalTopToBottom">
                  <Children>

                    <Widget DataSource="{ClanOverview}" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" >
                      <Children>

                        <!--Name-->
                        <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Center" MarginTop="20" Brush="MPLobby.Clan.Title.Text" Brush.FontSize="36" Text="@NameText" />

                        <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" HorizontalAlignment="Center" MarginTop="20" MarginLeft="100" MarginRight="100" StackLayout.LayoutMethod="HorizontalLeftToRight">
                          <Children>

                            <!-- Clan Info -->
                            <NavigationScopeTargeter ScopeID="LobbyClanChangeSigilScope" ScopeParent="..\ClanNameParent" />
                            <ButtonWidget Id="ClanNameParent" UpdateChildrenStates="true" DoNotPassEventsToChildren="true" WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Left" IsEnabled="@IsPrivilegedMember" Command.Click="ExecuteOpenChangeSigilPopup">
                              <Children>
                                <ListPanel UpdateChildrenStates="true" WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" StackLayout.LayoutMethod="VerticalTopToBottom" IsVisible="true" GamepadNavigationIndex="0">
                                  <Children>
                                    <!-- Title -->
                                    <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Center" Brush="MPLobby.Home.PlayerProfile.SubTitle.Text" Text="@ClanInfoTitleText" />
                                    <!-- Banner -->
                                    <MaskedTextureWidget DataSource="{SigilImage}" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" HorizontalAlignment="Center" SuggestedWidth="!Banner.Width.Scaled" SuggestedHeight="!Banner.Height.Scaled" Brush="MPLobby.Clan.Banner.Button" AdditionalArgs="@AdditionalArgs" ImageId="@Id" TextureProviderName="@TextureProviderName" IsDisabled="true"  />
                                    <ButtonWidget DoNotPassEventsToChildren="true" UpdateChildrenStates="true" WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Center" Command.Click="ExecuteOpenChangeFactionPopup" IsVisible="@IsPrivilegedMember">
                                      <Children>
                                        <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" Brush="MPLobby.Clan.ChangeBanner.Text" Text="@ChangeSigilText"/>
                                      </Children>
                                    </ButtonWidget>
                                  </Children>
                                </ListPanel>
                              </Children>
                            </ButtonWidget>

                            <ListPanel UpdateChildrenStates="true" WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" StackLayout.LayoutMethod="VerticalTopToBottom" GamepadNavigationIndex="0">
                              <Children>
                                <!--Member Count-->
                                <ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Center" StackLayout.LayoutMethod="VerticalTopToBottom">
                                  <Children>
                                    <!--Members-->
                                    <TextWidget WidthSizePolicy="Fixed" HeightSizePolicy="CoverChildren" SuggestedWidth="520" HorizontalAlignment="Center" MarginTop="50" Brush="MPLobby.Clan.SubTitle.Text" Text="@MembersText" />
                                  </Children>
                                </ListPanel>

                                <!--Invite Button-->
                                <NavigationScopeTargeter ScopeID="LobbyClanRosterInviteButtonScope" ScopeParent="..\InviteButton" />
                                <ButtonWidget Id="InviteButton" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="70" SuggestedHeight="70" Brush="InviteToClanButton.Flat" HorizontalAlignment="Center" Command.Click="ExecuteOpenInviteClanMemberPopup" DoNotPassEventsToChildren="true" UpdateChildrenStates="true" IsVisible="@IsPrivilegedMember" GamepadNavigationIndex="0">
                                  <Children>
                                    <HintWidget DataSource="{InviteMembersHint}" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Command.HoverBegin="ExecuteBeginHint" Command.HoverEnd="ExecuteEndHint"/>
                                  </Children>
                                </ButtonWidget>
                              </Children>
                            </ListPanel>

                            <!--Faction-->
                            <NavigationScopeTargeter ScopeID="ChangeFactionButtonScope" ScopeParent="..\FactionButton" />
                            <ButtonWidget Id="FactionButton" UpdateChildrenStates="true" DoNotPassEventsToChildren="true" WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Left" IsEnabled="@IsPrivilegedMember" Command.Click="ExecuteOpenChangeFactionPopup">
                              <Children>

                                <ListPanel UpdateChildrenStates="true" Id="ChangeFactionParent" WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Right" StackLayout.LayoutMethod="VerticalTopToBottom" GamepadNavigationIndex="0" >
                                  <Children>
                                    <!-- Banner -->
                                    <MaskedTextureWidget DataSource="{FactionBanner}" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" HorizontalAlignment="Center" SuggestedWidth="!Banner.Width.Scaled" SuggestedHeight="!Banner.Height.Scaled" Brush="MPLobby.Clan.Banner.Button" AdditionalArgs="@AdditionalArgs" ImageId="@Id" TextureProviderName="@TextureProviderName" IsDisabled="true"  />
                                    <ButtonWidget DoNotPassEventsToChildren="true" UpdateChildrenStates="true" WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Center" Command.Click="ExecuteOpenChangeFactionPopup" IsVisible="@IsPrivilegedMember" >
                                      <Children>
                                        <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" Brush="MPLobby.Clan.ChangeBanner.Text" Text="@ChangeFactionText"/>
                                      </Children>
                                    </ButtonWidget>
                                  </Children>
                                </ListPanel>

                              </Children>
                            </ButtonWidget>

                          </Children>
                        </ListPanel>


                      </Children>
                    </Widget>

                    <!-- Sub Page Selection  -->
                    <NavigationScopeTargeter ScopeID="LobbyClanLeftPanelScope" ScopeParent="..\LeftPanelParent" ScopeMovements="Horizontal" ExtendDiscoveryAreaTop="-30" ExtendDiscoveryAreaLeft="300" ExtendDiscoveryAreaRight="300" />
                    <ListPanel Id="LeftPanelParent" WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Center" MarginTop="175" StackLayout.LayoutMethod="HorizontalCentered" IntValue="@SelectedSubPageIndex">
                      <Children>

                        <!-- Overview Button -->
                        <ButtonWidget DoNotPassEventsToChildren="true" UpdateChildrenStates="true" HorizontalAlignment="Center" WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" Command.Click="ExecuteChangeEnabledSubPage" CommandParameter.Click="0" >
                          <Children>
                            <BrushWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="98" SuggestedHeight="80" HorizontalAlignment="Center" PositionYOffset="20" Brush="MPLobby.Clan.ManagementButton" GamepadNavigationIndex="0" />
                          </Children>
                        </ButtonWidget>

                        <!-- Roster Button -->
                        <ButtonWidget DoNotPassEventsToChildren="true" UpdateChildrenStates="true" HorizontalAlignment="Center" WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" Command.Click="ExecuteChangeEnabledSubPage" CommandParameter.Click="1" >
                          <Children>
                            <BrushWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="98" SuggestedHeight="80" HorizontalAlignment="Center" PositionYOffset="20" Brush="MPLobby.Clan.RosterButton" GamepadNavigationIndex="1" />
                          </Children>
                        </ButtonWidget>

                      </Children>
                    </ListPanel>


                  </Children>
                </Widget>

                <!-- Popups -->
                <Lobby.Clan.Change.Sigil.Popup DataSource="{ClanOverview\ChangeSigilPopup}" />
                <Lobby.Clan.Change.Faction.Popup DataSource="{ClanOverview\ChangeFactionPopup}" />

                <!-- Sub Page Content -->
                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" HorizontalAlignment="Center" VerticalAlignment="Center" MarginTop="10" MarginLeft="50" MarginRight="50" >
                  <Children>
                    <Lobby.Clan.Overview DataSource="{ClanOverview}" />
                    <Lobby.Clan.Roster DataSource="{ClanRoster}" />
                  </Children>
                </Widget>

                <!-- Exit Button -->
                <NavigationScopeTargeter ScopeID="LobbyClanCloseButtonScope" ScopeParent="..\CloseButton" />
                <ButtonWidget Id="CloseButton" DoNotPassEventsToChildren="true" UpdateChildrenStates="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="342" SuggestedHeight="69" MarginBottom="50" HorizontalAlignment="Center" VerticalAlignment="Bottom" Brush="WideButton.Flat" Command.Click="ExecuteClosePopup" GamepadNavigationIndex="0">
                  <Children>
                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" VerticalAlignment="Center" Brush="MPLobby.PlayButton.Text" Brush.FontSize="28" Brush.TextVerticalAlignment="Center" Text="@CloseText" />
                  </Children>
                </ButtonWidget>

              </Children>
            </ListPanel>

          </Children>
        </Widget>

      </Children>
    </Widget>
  </Window>
</Prefab>