<Prefab>
  <Window>
    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="BlankWhiteSquare_9" Color="#000000FF" AlphaFactor="0.7">
      <Children>

        <NavigationForcedScopeCollectionTargeter CollectionID="ClanCreatePopupCollection" CollectionParent="..\." />
        <Widget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="932" HorizontalAlignment="Center" VerticalAlignment="Center" Sprite="flat_panel_9" >
          <Children>

            <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginLeft="75" MarginRight="75" MarginTop="20" StackLayout.LayoutMethod="VerticalTopToBottom">
              <Children>
                <!-- Title -->
                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" HorizontalAlignment="Center" MarginBottom="25" Brush="MPLobby.Clan.Title.Text" Text="@CreateClanText" />

                <!-- How To Create A Clan -->
                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" HorizontalAlignment="Center" MarginBottom="25" Brush="MPLobby.Clan.SubTitle.Text" Text="@CreateClanDescriptionText" />

                <!-- No enough members -->
                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginLeft="150" MarginRight="150" Sprite="BlankWhiteSquare_9" Color="#000000FF" AlphaFactor="0.5" IsHidden="@DoesHaveEnoughPlayersToCreateClan">
                  <Children>
                    <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginLeft="25" MarginRight="25" MarginTop="35" MarginBottom="35" StackLayout.LayoutMethod="VerticalTopToBottom">
                      <Children>
                        <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" Brush="MPLobby.Clan.SubTitle.Text" MarginBottom="35" Text="@DontHaveEnoughPlayersInPartyText" />
                        <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" Brush="MPLobby.Clan.SubTitle.Text" Brush.FontColor="#FF0000FF" Brush.FontSize="42" Text="@PartyMemberCountText" />
                      </Children>
                    </ListPanel>
                  </Children>
                </Widget>

                <!-- Party Members -->
				  <GridWidget DataSource="{PartyMembers}" WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Center" MarginBottom="75" DefaultCellWidth="250" DefaultCellHeight="180" ColumnCount="3" LayoutImp="GridLayout" ClipContents="true">
                  <ItemTemplate>
                    <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" HorizontalAlignment="Center" SuggestedWidth="235" SuggestedHeight="170">
                      <Children>
                        <Widget DoNotPassEventsToChildren="true" UpdateChildrenStates="true" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" HorizontalAlignment="Center" VerticalAlignment="Center">
                          <Children>
                            <ImageIdentifierWidget DataSource="{Avatar}" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="90" SuggestedHeight="90" HorizontalAlignment="Center" VerticalAlignment="Top" MarginTop="30" ImageId="@Id" AdditionalArgs="@AdditionalArgs" IsVisible="@IsValid" TextureProviderName="@TextureProviderName" />
                            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren">
                              <Children>
                                <ScrollingRichTextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="75" HorizontalAlignment="Center" VerticalAlignment="Top" PositionYOffset="125" Brush="MPLobby.Clan.Name.Text" Brush.FontSize="20" Text="@Name" Brush.TextVerticalAlignment="Top"/>
                                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginTop="2" Brush="MPLobby.Clan.Name.Text" Brush.FontColor="#FF0000FF" Brush.FontSize="20" Text="@NotEligibleInfo" />
                              </Children>
                            </Widget>
                          </Children>
                        </Widget>
                      </Children>
                    </Widget>
                  </ItemTemplate>
                </GridWidget>

                <!-- Create Clan Button -->
                <NavigationScopeTargeter ScopeID="CreateButtonScope" ScopeParent="..\CreateButtonParent" />
                <Widget Id="CreateButtonParent" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="100" SuggestedHeight="100" HorizontalAlignment="Center">
                  <Children>
                    <HintWidget DataSource="{CantCreateHint}" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Command.HoverBegin="ExecuteBeginHint" Command.HoverEnd="ExecuteEndHint" IsEnabled="true" IsHidden="@CanCreateClan"/>
                    <ButtonWidget DoNotPassEventsToChildren="true" UpdateChildrenStates="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="100" SuggestedHeight="100" Brush="CreateGameButton.Flat" Command.Click="ExecuteOpenClanCreationPopup" IsEnabled="@CanCreateClan" GamepadNavigationIndex="0">
                      <Children>
                        <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Center" VerticalAlignment="Bottom" PositionYOffset="26" Brush="MPLobby.Matchmaking.CircleButtonText" Text="@CreateYourClanText" />
                        <HintWidget DataSource="{CantCreateHint}" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Command.HoverBegin="ExecuteBeginHint" Command.HoverEnd="ExecuteEndHint" IsEnabled="false" />
                      </Children>
                    </ButtonWidget>
                  </Children>
                </Widget>

              </Children>
            </ListPanel>

			  <!--Exit Button-->
        <NavigationScopeTargeter ScopeID="CloseButtonScope" ScopeParent="..\CloseButton" />
			  <ButtonWidget Id="CloseButton" DoNotPassEventsToChildren="true" UpdateChildrenStates="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="342" SuggestedHeight="69" MarginBottom="50" HorizontalAlignment="Center" VerticalAlignment="Bottom" Brush="WideButton.Flat" Command.Click="ExecuteClosePopup" GamepadNavigationIndex="0">
				  <Children>
					  <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" VerticalAlignment="Center" Brush="MPLobby.PlayButton.Text" Brush.FontSize="28" Brush.TextVerticalAlignment="Center" Text="@CloseText" />
				  </Children>
			  </ButtonWidget>
			  
          </Children>
        </Widget>

      </Children>
    </Widget>
  </Window>
</Prefab>