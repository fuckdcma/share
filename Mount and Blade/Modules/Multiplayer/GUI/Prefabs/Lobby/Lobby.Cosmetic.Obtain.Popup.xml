                                        <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="StretchToParent" Brush="Report.Button.Text" Text="@ContinueText"/>
                                        <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="25" SuggestedHeight="25" VerticalAlignment="Center" Sprite="MPLobby\Generic\mp_loot_icon" Color="#E0A73EFF" IsHidden="@IsObtainSuccessful" />
                                      </Children>
                                    </ListPanel>

                                    <ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="StretchToParent" HorizontalAlignment="Center" StackLayout.LayoutMethod="HorizontalLeftToRight" IsHidden="@CanObtain">
                                      <Children>
                                        <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="StretchToParent" Brush="Report.Button.Text" Text="@NotEnoughLootText"/>
                                        <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="25" SuggestedHeight="25" VerticalAlignment="Center" Sprite="MPLobby\Generic\mp_loot_icon" Color="#E0A73EFF" />
                                      </Children>
                                    </ListPanel>
                                  </Children>
                                </ButtonWidget>

                                <!-- Current Loot Amount-->
                                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginTop="0" Brush="MPLobby.Armory.Cosmetic.LootAmount.Text" Text="@CurrentLootText" Brush.FontSize="24" />

                              </Children>
                            </ListPanel>

                            <Widget Id="TauntPopupResultSuccessfulIcon" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="200" SuggestedHeight="200" Sprite="MPLobby\Generic\succeed_icon" HorizontalAlignment="Center" VerticalAlignment="Center" MarginTop="0" MarginBottom="0" Color="#F4E1C4FF"/>
                            <Widget Id="TauntPopupResultFailedIcon" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="200" SuggestedHeight="200" Sprite="MPLobby\Generic\failed_icon" Color="#b00808ff" HorizontalAlignment="Center" VerticalAlignment="Center" MarginTop="0" MarginBottom="0"/>
                            <TextWidget Id="TauntPopupResultText" WidthSizePolicy="Fixed" HeightSizePolicy="CoverChildren" SuggestedWidth="500" HorizontalAlignment="Center" VerticalAlignment="Center" MarginTop="220" Text="@ObtainResultText" Brush="MPLobby.Cosmetic.Obtain.Result.Text" />

                            <Standard.CircleLoadingWidget Id="TauntPopupLoadingAnimation" WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" SuggestedWidth="500" HorizontalAlignment="Center" VerticalAlignment="Center" MarginBottom="40" Parameter.Period="0.5" />

                          </Children>
                        </Widget>

                      </Children>
                    </Widget>

                  </Children>
                </MultiplayerLobbyArmoryCosmeticTierVisualBrushWidget>
                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="3" Sprite="popup_gradient_background_9" Color="#FEC157FF" />

                <!--Click to Continue Text-->
                <TextWidget DoNotAcceptEvents="true" WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Center" MarginTop="15"  Brush="MPLobby.Profile.Popup.SubTitle.Text" Text="@ClickToCloseText" />

              </Children>
            </ListPanel>

          </Children>
        </MultiplayerLobbyArmoryCosmeticObtainPopupWidget>
      </Children>
    </Widget>
  </Window>
