										<NavigationScopeTargeter ScopeID="ArmoryCustomizationCosmeticsGridScope" ScopeParent="..\ClipRect" ScopeMovements="Horizontal" AlternateScopeMovements="Vertical" AlternateMovementStepSize="3" />
