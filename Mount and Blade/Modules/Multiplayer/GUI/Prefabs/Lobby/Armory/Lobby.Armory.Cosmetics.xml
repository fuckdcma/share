                                <BrushWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="15" SuggestedHeight="15" VerticalAlignment="Center" MarginLeft="7" PositionYOffset="-2" Brush="MPLobby.Filters.Dropdown.Arrow"/>
                              </Children>
                            </ListPanel>
                          </Children>
                        </Widget>
                      </Children>
                    </ButtonWidget>
                    <Widget Id="ListContainer" IsVisible="false" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginTop="40" MarginLeft="8" MarginRight="8" Sprite="region_combobox_bg_9" Color="#000000FF" AlphaFactor="0.9">
