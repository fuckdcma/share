                      </Children>
                    </Widget>

                    <!--Scroll Gradient-->
                    <Widget DoNotAcceptEvents="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="576" SuggestedHeight="57" HorizontalAlignment="Right" PositionXOffset="12" VerticalAlignment="Bottom" Sprite="CharacterCreation\character_creation_scroll_gradient" />

