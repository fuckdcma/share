						<NavigationScopeTargeter ScopeID="ArmoryCustomizationTabsScope" ScopeParent="..\TabsParent" ScopeMovements="Horizontal" ExtendDiscoveryAreaBottom="-20" ExtendDiscoveryAreaTop="-20" />
